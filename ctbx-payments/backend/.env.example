# Valores documentais. Não inclua credenciais neste arquivo.
PORT=3000
# Development/test usam 0.0.0.0 por padrão para acesso na rede local.
# Em production, o default seguro é 127.0.0.1; configure HOST conforme a infraestrutura.
HOST=0.0.0.0
NODE_ENV=development
API_VERSION=v1
LOG_LEVEL=info

# Mídia do CMS (Cloudinary) — só usado em dev/test (ver src/app.ts). Em dev
# local, estas variáveis também podem vir do .env.local na raiz do projeto
# Expo (carregado automaticamente por src/config/loadLocalEnv.ts).
# Nunca preencha valores aqui.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# NÃO USADO MAIS por nenhuma rota — media/sign e media/destroy agora exigem
# sessão real de admin (ver ADMIN_SESSION_SECRET/DATABASE_URL abaixo), não
# mais este token. Mantido documentado só por retrocompatibilidade.
ADMIN_API_TOKEN=

# Persistência real do CMS + sessão real do admin. Sem as duas, nem
# /admin/auth/* nem /admin/media/* respondem (fail closed) — ver src/app.ts.
# Connection string do Postgres (ex.: postgresql://user:pass@host:5432/db).
# NÃO preencha aqui — só no seu .env.local, nunca commitado.
DATABASE_URL=
# Assina o cookie de sessão do admin (@fastify/cookie). Gere um valor
# aleatório local (ex.: openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# Usados só pelo script manual `npm run db:seed-admin` (backend/scripts/
# seedAdminUser.ts) — nunca lidos pelo servidor. Não preencha aqui.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Envio de e-mail (Resend) — infraestrutura pronta (ver
# providers/createEmailProvider.ts), mas ainda não usada por nenhuma rota
# real (nenhum fluxo de e-mail existe no produto hoje). Fail-closed em
# produção: sem as duas, o provider real nem instancia — nunca há fallback
# silencioso para o mock em produção. Fora de produção, sem elas, cai
# automaticamente para um provider em memória (nenhum e-mail real sai por
# omissão). Não preencha aqui — só no seu .env.local, nunca commitado.
RESEND_API_KEY=
# Endereço/domínio remetente ainda não definido para o CTBX Payments —
# propositalmente deixado vazio até essa decisão ser tomada.
EMAIL_FROM=
# Base do link enviado nos e-mails de verificação/recuperação (ex.:
# https://app.ctbxpayments.com). Ainda não definido — sem isto, o link
# usa um fallback só de desenvolvimento local. Não preencha aqui.
CUSTOMER_APP_BASE_URL=
