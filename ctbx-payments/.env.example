# Copie para um arquivo .env.local, que não deve ser versionado.
EXPO_PUBLIC_APP_MODE=DEMO
# Obrigatória somente em SANDBOX. Use uma URL local acessível pelo simulador/aparelho.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Mesmo valor de ADMIN_API_TOKEN do backend (ver backend/.env.example) — o
# Painel Administrativo envia isto no header X-Admin-Token ao chamar
# /v1/admin/media/*. É EXPO_PUBLIC_ (fica visível no bundle web do painel,
# como qualquer variável deste prefixo); não é o segredo do Cloudinary, que
# nunca sai do backend.
EXPO_PUBLIC_ADMIN_API_TOKEN=

# As variáveis abaixo NÃO usam prefixo EXPO_PUBLIC_ de propósito — não vão
# para o bundle do app. São lidas só pelo backend (ver
# backend/src/config/loadLocalEnv.ts), que carrega este mesmo .env.local.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ADMIN_API_TOKEN=
