# Formulário de Contato (Resend). NUNCA commitar valores reais.
# Chave do Resend com permissão só de envio ("Sending access").
RESEND_API_KEY=
# Remetente em domínio verificado no Resend, ex.: CTBX Payments <site@ctbxpayments.com>
CONTACT_FROM_EMAIL=
# Caixa(s) que recebem as mensagens, separadas por vírgula.
CONTACT_TO_EMAIL=
