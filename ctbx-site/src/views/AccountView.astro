---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import OnboardingSteps from '../components/OnboardingSteps.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImage from '../assets/hero-mobile-card.png';
import { t, type Lang } from '../i18n/ui';
import { openAccountHref } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const p = c.pages.account;
---
<Page lang={lang} routeKey="account" title={p.meta.title} description={p.meta.description}>
  <PageHero {...p.hero} image={heroImage} primary={{ label: c.nav.openAccount, href: openAccountHref(lang) }} />
  <OnboardingSteps lang={lang} />
  <ServicesGrid lang={lang} title={p.comingTitle} intro={p.comingIntro} />
  <CtaBand lang={lang} />
</Page>
