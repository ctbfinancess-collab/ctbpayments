---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import OnboardingSteps from '../components/OnboardingSteps.astro';
import { t, type Lang } from '../i18n/ui';
import { openAccountHref } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const p = c.pages.account;
---
<Page lang={lang} routeKey="account" title={p.meta.title} description={p.meta.description}>
  <PageHero {...p.hero} variant="cinematic" focus="60% 6%" focusMobile="62% top" video={{ src: '/media/robo-contato.mp4', poster: '/media/robo-contato.jpg' }} primary={{ label: c.nav.openAccount, href: openAccountHref(lang) }} />
  <OnboardingSteps lang={lang} />
</Page>
