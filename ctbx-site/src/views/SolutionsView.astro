---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const p = c.pages.solutions;
---
<Page lang={lang} routeKey="solutions" title={p.meta.title} description={p.meta.description}>
  <PageHero {...p.hero} variant="cinematic" heightScale={1.05} focus="center center" focusMobile="40% center" video={{ src: '/media/executiva-globo.mp4', poster: '/media/executiva-globo.jpg' }} />
  <ServicesGrid lang={lang} />
  <CtaBand lang={lang} />
</Page>
