---
// Banner do topo em carrossel. Sem JavaScript, mostra só o primeiro slide.
// Com JS: troca sozinho a cada 6s (pausa só no botão de pausa, ao navegar com teclado
// e quando a aba está em segundo plano). Há botão de pausar/continuar.
// Cada slide tem um vídeo de fundo em tela cheia (mudo, em ciclo de ida e
// volta, em public/media/). Só o vídeo do slide visível toca; os outros só
// carregam quando chega a vez deles. Com "reduzir movimento" ativado, fica
// só a imagem fixa (poster) e o parallax fica desligado.
import { Image } from 'astro:assets';
import hlSecurity from '../assets/icons/hl-security.png';
import hlAccount from '../assets/icons/hl-account.png';
import hlBusiness from '../assets/icons/hl-business.png';
import hlPayments from '../assets/icons/hl-payments.png';
import hlGlobe from '../assets/icons/about-globe.png';
// Ícones metálicos da faixa de destaques (mesma ordem de h.highlights).
const hlIcons = [hlSecurity, hlAccount, hlBusiness, hlPayments, hlGlobe];
import { t, type Lang } from '../i18n/ui';
import { href, type RouteKey } from '../i18n/routes';
import { openAccountHref } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = t(lang).hero;
// "Abrir conta" (contact) respeita o destino configurado em site.ts.
const hrefFor = (to: string) => (to === 'contact' ? openAccountHref(lang) : href(lang, to as RouteKey));

// Vídeo e enquadramento de cada slide (mesma ordem dos textos em ui.ts).
// "pos"/"posMobile" mantêm o objeto principal visível quando a tela corta.
const images = [
  // Slide 1: o globo é posicionado pelo script (data-subject): centro do
  // globo em 79%/42% do quadro e diâmetro = 60% da altura do quadro.
  { video: '/media/globo-dourado.mp4', poster: '/media/globo-dourado.jpg', pos: '70% 45%', posMobile: '68% center', subject: { cx: 0.79, cy: 0.42, d: 0.60 } },
  // Slide 2 ("na palma da mão"): robô segurando o celular, em tela cheia.
  { video: '/media/robo-contato.mp4', poster: '/media/robo-contato.jpg', pos: '60% 8%', posMobile: '62% top' },
  // Slide 3: cartão CTBX girando (gira e volta ao início sozinho: sem ida e volta).
  { video: '/media/cartao-ctbx-girando.mp4', poster: '/media/cartao-ctbx-girando.jpg', pos: '50% center', posMobile: '50% center', box: { x0: 0.05, y0: 0.05, x1: 0.95, y1: 0.95, h: 1.0, cx: 0.66 } },
  // Slide 4 (empresas): cartão, celular e globo; enquadrado pelo conjunto (a câmera se aproxima).
  { video: '/media/cartao-celular-globo.mp4', poster: '/media/cartao-celular-globo.jpg', pos: '85% center', posMobile: '72% center', box: { x0: 0.47, y0: 0.02, x1: 1.0, y1: 0.84, h: 0.86, cx: 0.70 } },
];
const slides = h.slides.map((s, i) => ({ ...s, ...images[i] }));
---
<section class="hero relative isolate flex min-h-[530px] flex-col overflow-hidden lg:min-h-[min(85svh,833px)]" aria-roledescription="carousel" aria-label="CTBX Payments" data-carousel>
  <!-- Fundos -->
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    {slides.map((s, i) => (
      <div class:list={['hero-layer absolute inset-0', i === 0 && 'is-active', s.subject && 'has-subject', s.box && 'has-box']} data-slide-bg={i} data-subject={s.subject ? JSON.stringify(s.subject) : undefined} data-box={s.box ? JSON.stringify(s.box) : undefined} style={`--pos:${s.pos};--pos-m:${s.posMobile}`}>
        <video
          class="hero-bg"
          muted
          loop
          playsinline
          disablepictureinpicture
          preload={i === 0 ? 'auto' : 'none'}
          poster={s.poster}
          data-src={s.video}
          src={i === 0 ? s.video : undefined}
        ></video>
      </div>
    ))}
  </div>
  <div class="hero-text-shade absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- Textos (todos ocupam a mesma célula do grid; só o ativo aparece) -->
  <div class="hero-content container-wide grid flex-1 items-center pb-4 pt-[108px] lg:pt-[118px]">
    {slides.map((s, i) => {
      const Heading = i === 0 ? 'h1' : 'h2';
      return (
        <div
          class:list={['hero-slide flex max-w-[720px] flex-col gap-4 [grid-area:1/1]', i === 0 && 'is-active']}
          data-slide={i}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${slides.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          inert={i === 0 ? undefined : true}
        >
          <Heading class="title-gold text-[clamp(36px,4vw,68px)]">
            <span class="block">{s.titleTop}</span>
            <span class="block">{s.titleAccent}</span>
          </Heading>
          <p class="max-w-[34ch] text-[clamp(16px,1.45vw,24px)] font-light leading-snug text-ice/90">{s.subtitle}</p>
          <div class="mt-2 flex flex-wrap gap-3">
            <a href={hrefFor(s.primary.to)} class="btn btn-primary !px-8 !py-3.5 !text-[clamp(15px,1.1vw,18px)]">
              {s.primary.label}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
            {s.secondary && <a href={hrefFor(s.secondary.to)} class="btn btn-ghost !px-7 !py-3.5 !text-[clamp(15px,1.1vw,18px)]">{s.secondary.label}</a>}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Controles -->
  <div class="container-wide flex items-center gap-4 pb-4">
    <button type="button" class="hero-arrow" data-prev aria-label={h.prev}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <div class="flex items-center gap-2">
      {slides.map((_, i) => (
        <button type="button" class:list={['hero-dot', i === 0 && 'is-active']} data-dot={i} aria-label={`${h.goTo} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}><span></span></button>
      ))}
    </div>
    <button type="button" class="hero-arrow" data-next aria-label={h.next}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <button type="button" class="hero-arrow" data-toggle aria-label={h.pause} data-label-pause={h.pause} data-label-play={h.play}>
      <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
      <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10-6.5a1 1 0 0 0 0-1.72l-10-6.5A1 1 0 0 0 8 5.5z" /></svg>
    </button>
  </div>

  <!-- Barra de destaques -->
  <div class="container-wide pb-8 lg:pb-10" data-highlights>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-5 lg:gap-0">
      {h.highlights.map((item, i) => (
        <li class="hl-item flex items-center gap-4 lg:justify-center lg:px-5">
          <Image src={hlIcons[i]} alt="" width={56} densities={[1, 2]} class="h-14 w-14 shrink-0 object-contain drop-shadow-[0_6px_14px_rgba(0,0,0,0.5)]" />
          <span class="flex flex-col gap-1">
            <span class="text-[clamp(14px,1.1vw,18px)] leading-snug text-ice">{item.label}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Troca: fundo em fade lento, texto entra subindo levemente. */
  .hero-layer { opacity: 0; transition: opacity 1.2s ease; background: #1C1E21; }
  .hero-layer.is-active { opacity: 1; }
  .hero-slide { opacity: 0; transform: translateY(14px); transition: opacity .7s ease, transform .7s ease; pointer-events: none; }
  .hero-slide.is-active { opacity: 1; transform: none; transition-delay: .25s; pointer-events: auto; }

  /* Como na CTB Finances: o vídeo PREENCHE o banner inteiro (de ponta a
     ponta, abaixo do cabeçalho), com o assunto grande à direita; o texto
     fica sobre o vídeo com sombreado grafite à esquerda e na base. Cores do
     vídeo intactas (sem filtro). */
  .hero-layer { top: 84px; overflow: hidden; }
  .hero-layer :global(.hero-bg) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: var(--pos, center);
    will-change: transform;
  }
  .hero-text-shade {
    background:
      linear-gradient(90deg, rgba(20, 22, 25, 0.9) 0%, rgba(20, 22, 25, 0.74) 28%, rgba(20, 22, 25, 0.3) 44%, rgba(20, 22, 25, 0) 58%),
      linear-gradient(180deg, rgba(20, 22, 25, 0) 62%, rgba(20, 22, 25, 0.55) 84%, rgba(20, 22, 25, 0.85) 100%);
  }
  @media (min-width: 1024px) {
    .hero-layer { top: 104px; }
  }
  /* Slide do globo: posicionado pelo script para o globo ocupar quase toda
     a altura do banner, centrado em ~78% da largura (como o globo da CTB
     Finances, podendo passar um pouco das bordas). */
  @media (min-width: 1024px) {
    .hero-layer.has-subject :global(.hero-bg) { inset: auto; max-width: none; object-fit: fill; }
    /* Slides 2 e 3: o conjunto de elementos cabe inteiro (~86–90% da altura),
       à direita; as bordas do quadro se fundem ao grafite. */
    .hero-layer.has-box :global(.hero-bg) {
      inset: auto; max-width: none; object-fit: fill;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 94%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 6%, #000 92%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 94%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 6%, #000 92%, transparent 100%);
      mask-composite: intersect;
    }
  }
  .hero-slide p, .hero-slide .btn-ghost { text-shadow: 0 2px 18px rgba(0, 0, 0, 0.75), 0 1px 3px rgba(0, 0, 0, 0.6); }
  .hero-slide :global(.title-gold) { filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.7)); }
  /* Destaques como na CTB Finances: ícone dourado + texto, sobre o vídeo,
     separados por linhas finas (sem caixas cobrindo a imagem). */
  @media (min-width: 1024px) {
    .hl-item + .hl-item { border-left: 1px solid rgba(217, 191, 142, 0.28); }
  }
  /* Celular/tablet: vídeo no alto, largura total; texto abaixo. */
  @media (max-width: 1023px) {
    .hero-layer :global(.hero-bg) {
      bottom: auto; height: auto; aspect-ratio: 16 / 9;
      -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
    }
    .hero-text-shade { display: none; }
    .hero-content { padding-top: calc(84px + 56.25vw - 8px) !important; }
  }

  .hero-arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 999px;
    border: 1px solid rgba(191, 194, 199, 0.3); color: rgba(244, 244, 242, 0.85);
    transition: border-color .2s, color .2s;
  }
  .hero-arrow:hover { border-color: var(--color-orange-300); color: var(--color-ice); }
  .hero-dot { padding: 10px 2px; }
  .hero-dot span { position: relative; display: block; overflow: hidden; width: 18px; height: 3px; border-radius: 3px; background: rgba(191, 194, 199, 0.35); transition: width .4s; }
  .hero-dot.is-active span { width: 40px; background: rgba(197, 164, 108, 0.3); }
  .hero-dot.is-active span::after {
    content: ""; position: absolute; inset: 0; transform-origin: left; background: var(--color-orange-brand);
    animation: hero-progress var(--hero-interval, 6s) linear forwards;
  }
  [data-carousel].is-paused .hero-dot.is-active span::after { animation-play-state: paused; }
  @keyframes hero-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  [data-toggle] .icon-play { display: none; }
  [data-carousel].is-paused [data-toggle] .icon-play { display: block; }
  [data-carousel].is-paused [data-toggle] .icon-pause { display: none; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const bgs = [...root.querySelectorAll<HTMLElement>('[data-slide-bg]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const INTERVAL = 6000;
    let index = 0;
    let timer: number | undefined;
    let paused = false;

    // Só o vídeo do slide visível toca; os outros ficam parados. O arquivo
    // de cada vídeo só é baixado quando o slide aparece pela primeira vez.
    const videos = bgs.map((el) => el.querySelector<HTMLVideoElement>('video')!);
    const syncVideos = () => {
      videos.forEach((v, i) => {
        if (i === index && !reduce && !document.hidden) {
          if (!v.getAttribute('src') && v.dataset.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
      // Pré-carrega o próximo para a troca não piscar.
      const next = videos[(index + 1) % videos.length];
      if (!reduce && next && !next.getAttribute('src') && next.dataset.src) { next.preload = 'auto'; next.src = next.dataset.src; }
    };
    if (reduce) videos.forEach((v) => { v.removeAttribute('src'); v.load(); });

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((el, i) => {
        const on = i === index;
        el.classList.toggle('is-active', on);
        el.toggleAttribute('inert', !on);
        if (on) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
      });
      bgs.forEach((el, i) => el.classList.toggle('is-active', i === index));
      syncVideos();
      dots.forEach((el, i) => {
        el.classList.remove('is-active');
        void el.offsetWidth; // reinicia a barra de progresso
        el.classList.toggle('is-active', i === index);
        if (i === index) el.setAttribute('aria-current', 'true'); else el.removeAttribute('aria-current');
      });
    };
    // Troca sozinho a cada 6s. Para só quando o visitante pausa, quando a
    // aba fica em segundo plano ou enquanto alguém navega pelo teclado.
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => { stop(); if (paused) return; timer = window.setInterval(() => show(index + 1), INTERVAL); };
    const setPaused = (value: boolean) => {
      paused = value;
      root.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) || '');
      if (paused) stop(); else { show(index); start(); }
    };
    toggle.addEventListener('click', () => setPaused(!paused));

    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(index - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(index + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.addEventListener('keyup', (e) => { if (e.key === 'Tab') stop(); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) start(); });
    document.addEventListener('visibilitychange', () => { syncVideos(); if (document.hidden) stop(); else start(); });

    // Arrastar para o lado no celular.
    let touchX: number | null = null;
    root.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) { show(index + (dx < 0 ? 1 : -1)); start(); }
      touchX = null;
    });

    // Parallax sutil: o fundo desce mais devagar que o texto.
    if (!reduce) {
      const imgs = [...root.querySelectorAll<HTMLElement>('.hero-bg')];
      window.addEventListener('scroll', () => {
        const y = Math.min(window.scrollY, 900) * 0.25;
        imgs.forEach((img) => { img.style.transform = `translateY(${y}px)`; });
      }, { passive: true });
    }

    // Altura da faixa de cartões, para o vídeo terminar logo acima dela.
    const highlights = root.querySelector<HTMLElement>('[data-highlights]');
    // Slide(s) com assunto marcado (globo): calcula tamanho e posição do vídeo
    // para o assunto ficar com ~78% da altura útil, centrado em 75% da largura.
    const layoutSubjects = () => {
      const desktop = window.matchMedia('(min-width: 1024px)').matches;
      bgs.forEach((layer) => {
        const raw = layer.dataset.subject; const v = layer.querySelector<HTMLVideoElement>('video');
        if (!raw || !v) return;
        if (!desktop) { v.style.cssText = ''; return; }
        const { cx, cy, d } = JSON.parse(raw);
        const W = layer.clientWidth, H = layer.clientHeight;
        const frameH = (0.98 * H) / d, frameW = frameH * 16 / 9;
        const globeTop = -0.01 * H;
        const left = 0.78 * W - cx * frameW;
        const top = globeTop + (d / 2) * frameH - cy * frameH;
        Object.assign(v.style, { width: frameW + 'px', height: frameH + 'px', left: left + 'px', top: top + 'px' });
      });
    };
    // Slides com caixa (conjunto de elementos): todo o conjunto cabe na altura
    // indicada, centrado em cx da largura; nada do conjunto sai do quadro.
    const layoutBoxes = () => {
      const desktop = window.matchMedia('(min-width: 1024px)').matches;
      bgs.forEach((layer) => {
        const raw = layer.dataset.box; const v = layer.querySelector<HTMLVideoElement>('video');
        if (!raw || !v) return;
        if (!desktop) { v.style.cssText = ''; return; }
        const b = JSON.parse(raw);
        const W = layer.clientWidth, H = layer.clientHeight;
        let frameH = (b.h * H) / (b.y1 - b.y0);
        // não deixa o conjunto ficar mais largo que ~62% da tela
        const maxBoxW = 0.62 * W; if ((b.x1 - b.x0) * frameH * 16 / 9 > maxBoxW) frameH = maxBoxW / ((b.x1 - b.x0) * 16 / 9);
        const frameW = frameH * 16 / 9;
        let left = b.cx * W - ((b.x0 + b.x1) / 2) * frameW;
        // o lado direito do conjunto nunca passa da borda da tela
        const boxRight = left + b.x1 * frameW; if (boxRight > W - 16) left -= boxRight - (W - 16);
        const boxH = (b.y1 - b.y0) * frameH;
        const top = (H - boxH) / 2 - b.y0 * frameH;
        Object.assign(v.style, { width: frameW + 'px', height: frameH + 'px', left: left + 'px', top: top + 'px' });
      });
    };
    const measure = () => { if (highlights) root.style.setProperty('--hl-h', highlights.offsetHeight + 'px'); layoutSubjects(); layoutBoxes(); };
    measure();
    window.addEventListener('resize', measure, { passive: true });

    syncVideos();
    start();
  }
</script>
