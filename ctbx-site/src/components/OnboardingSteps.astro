---
// As 3 etapas do cadastro que já funcionam para clientes reais.
import { Image } from 'astro:assets';
import stepSignup from '../assets/step-signup.png';
import stepEmail from '../assets/step-email.png';
import stepKyc from '../assets/step-kyc.png';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang).onboarding;
const stepImages = [stepSignup, stepEmail, stepKyc];
---
<section class="border-b border-line bg-navy-800/60">
  <div class="container-site py-20 md:py-24">
    <div class="mb-12 flex flex-col gap-3">
      {c.eyebrow && <span class="eyebrow">{c.eyebrow}</span>}
      <h2 class="section-title">{c.title}</h2>
      {c.intro && <p class="text-slate-brand">{c.intro}</p>}
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      {c.steps.map((step, i) => (
        <li class="card group">
          <div class="media relative aspect-[16/10] overflow-hidden">
            <Image src={stepImages[i]} alt="" widths={[400, 640, 900]} sizes="(min-width: 768px) 33vw, 100vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
            <span class="absolute left-4 top-4 rounded-full bg-navy-950/70 px-2.5 py-1 font-display text-xs font-semibold text-ice backdrop-blur tabular-nums">0{i + 1}</span>
          </div>
          <div class="flex flex-1 flex-col gap-3 p-6">
            <h3 class="card-title">{step.title}</h3>
            <p class="text-[15px] leading-relaxed text-slate-brand">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
