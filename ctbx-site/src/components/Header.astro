---
import { Image } from 'astro:assets';
import emblem from '../assets/ctbx-emblem.png';
import wordmark from '../assets/ctbx-wordmark.png';
import { t, type Lang } from '../i18n/ui';
import { routes, href, navOrder, type RouteKey } from '../i18n/routes';
import { openAccountHref, signInHref } from '../config/site';

interface Props { lang: Lang; routeKey: RouteKey }
const { lang, routeKey } = Astro.props;
const s = t(lang).nav;
const links = navOrder.map((key) => ({ key, href: href(lang, key), label: s[key] }));
const ptHref = routes[routeKey]['pt-br'];
const enHref = routes[routeKey].en;
---
<!-- Transparente sobre o banner; ganha fundo sólido ao rolar a página. -->
<header id="site-header" class="fixed inset-x-0 top-0 z-40 transition-[background-color,border-color,backdrop-filter] duration-300">
  <div class="container-wide flex h-[84px] items-center justify-between gap-6 lg:h-[104px]">
    <!-- Marca como na referência: emblema, traço vertical e PAYMENTS em dourado. -->
    <a href={href(lang, 'home')} class="flex shrink-0 items-center gap-4 lg:gap-6" aria-label="CTBX Payments">
      <Image src={emblem} alt="" width={76} densities={[1, 2]} class="h-auto w-[52px] lg:w-[76px]" loading="eager" />
      <span class="h-10 w-px bg-ice/30 lg:h-14" aria-hidden="true"></span>
      <Image src={wordmark} alt="Payments" height={26} densities={[1, 2]} class="h-[18px] w-auto lg:h-[26px]" loading="eager" />
    </a>

    <nav class="hidden items-center gap-6 xl:flex 2xl:gap-8" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.key === routeKey ? 'page' : undefined}
          class:list={[
            'nav-link whitespace-nowrap transition-colors hover:text-orange-300',
            l.key === routeKey ? 'is-current text-orange-300' : 'text-ice',
          ]}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <!-- Idioma: globo + sigla, abre a lista PT/EN. -->
      <details class="lang relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full px-2 py-2 text-[15px] text-ice/90 hover:text-ice" aria-label={s.langLabel}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
          <span>{lang === 'en' ? 'EN' : 'PT'}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </summary>
        <div class="absolute right-0 mt-2 flex w-36 flex-col rounded-xl border border-line bg-navy-800 p-1.5 shadow-2xl" role="group" aria-label={s.langLabel}>
          <a href={ptHref} lang="pt-BR" class:list={['rounded-lg px-3 py-2 text-sm hover:bg-navy-700', lang === 'pt-br' ? 'text-orange-300' : 'text-ice/85']} aria-current={lang === 'pt-br' ? 'true' : undefined}>Português</a>
          <a href={enHref} lang="en" class:list={['rounded-lg px-3 py-2 text-sm hover:bg-navy-700', lang === 'en' ? 'text-orange-300' : 'text-ice/85']} aria-current={lang === 'en' ? 'true' : undefined}>English</a>
        </div>
      </details>
      {signInHref && <a href={signInHref} class="nav-link hidden whitespace-nowrap px-2 text-[15px] text-ice transition-colors hover:text-orange-300 sm:inline-flex">{s.signIn}</a>}
      <a href={openAccountHref(lang)} class="btn btn-outline hidden whitespace-nowrap !px-6 !py-2.5 !text-[15px] !font-medium sm:inline-flex">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
        {s.openAccount}
      </a>
      <details class="relative xl:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-ice/20" aria-label={s.menu}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav class="absolute right-0 mt-3 flex w-60 flex-col gap-1 rounded-2xl border border-line bg-navy-800 p-3 shadow-2xl" aria-label={s.menu}>
          {links.map((l) => (
            <a href={l.href} aria-current={l.key === routeKey ? 'page' : undefined} class:list={['rounded-lg px-3 py-2 text-[15px] hover:bg-navy-700 hover:text-ice', l.key === routeKey ? 'bg-navy-700 text-ice' : 'text-slate-brand']}>{l.label}</a>
          ))}
          {signInHref && <a href={signInHref} class="rounded-lg px-3 py-2 text-[15px] text-slate-brand hover:bg-navy-700 hover:text-ice">{s.signIn}</a>}
          <a href={openAccountHref(lang)} class="btn btn-primary mt-2 !py-2.5 !text-sm">{s.openAccount}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Cabeçalho como na CTB Finances: fundo grafite escuro quase opaco desde
     o topo, para a imagem do banner não atrapalhar a leitura do menu. */
  #site-header {
    background: rgba(20, 22, 25, 0.96);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  /* Menu, idioma e botão na mesma fonte do menu da CTB Finances (Inter 400,
     0,95rem), em texto claro; o item ativo fica em dourado. */
  .nav-link { font-size: 0.95rem; font-weight: 400; letter-spacing: 0.005em; }
  #site-header.is-scrolled .container-wide { height: 76px; }
  .nav-link { position: relative; padding-block: 6px; }
  .nav-link.is-current::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px;
    background: var(--color-orange-brand);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
